# Copy to .env. Every value here is a non-secret dev default.
NODE_ENV=development
PORT=8080

# `npm run db` starts an embedded PostgreSQL 17 on this port.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/summer
DB_POOL_MAX=10
# Apply pending migrations when the server boots (dev convenience; run `npm run db:migrate` in prod).
DB_MIGRATE_ON_START=true

# Identity adapter: `dev` (signed dev tokens + /api/auth/dev-sso popup) or `sso` (not implemented yet).
AUTH_PROVIDER=dev
DEV_TOKEN_SECRET=change-me-dev-only
# Username the dev SSO popup signs in as (any user in src/database/seed/identities.ts).
DEV_LOGIN_USER=mgolan
# How long a verified identity + its groups are cached before being re-resolved.
AUTH_CACHE_TTL_SECONDS=60

# External group keys (permissions.group_name) whose members may manage permission groups.
PERMISSION_ADMIN_GROUPS=staff

# Wall-clock zone for eventDate/eventSecTime and date-range filters.
APP_TIMEZONE=Asia/Jerusalem

UPLOAD_DIR=.data/uploads
MAX_FILE_MB=50
MAX_FILES_PER_SUMMARY=20
EXPORT_MAX=5000
IMPORT_MAX_ROWS=2000

# Browser extension package (summer-extension.crx + summer-extension.json), written by summer-extension/scripts/pack.mjs.
EXTENSION_DIR=../summer-extension-dist

# Links in e-mails point here.
APP_URL=http://localhost:81
# E-mail: `log` writes mails to the server log (dev); `graph` sends through Microsoft Graph as MAIL_FROM's mailbox;
# `smtp` sends through SMTP_URL (e.g. smtp://user:pass@host:587). Try it: npm run mail:test
MAIL_TRANSPORT=log
SMTP_URL=
MAIL_FROM=Summer <summer@localhost>
# For `graph`: an Entra app registration with the Mail.Send application permission (admin consent) and a client secret.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# Send every mail to this address instead of its recipient (the subject keeps who it was for). Empty = real recipients.
MAIL_REDIRECT_TO=
# With MAIL_TRANSPORT=log, also write each mail as an .html file here to open in a browser. Empty = off.
MAIL_PREVIEW_DIR=.data/mail-preview
# How often pending e-mails are sent (seconds; 0 = off), and the local hour of the daily digest.
MAIL_POLL_SECONDS=30
DIGEST_HOUR=8
