# Copy to .env. Every value here is a non-secret dev default.
NODE_ENV=development
PORT=8080

# `npm run db` starts an embedded PostgreSQL 17 on this port.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/summer
DB_POOL_MAX=10
# Apply pending migrations when the server boots (dev convenience; run `npm run db:migrate` in prod).
DB_MIGRATE_ON_START=true

# Identity adapter: `dev` (signed dev tokens + /api/auth/dev-sso popup) or `sso` (not implemented yet).
AUTH_PROVIDER=dev
DEV_TOKEN_SECRET=change-me-dev-only
# Username the dev SSO popup signs in as (any user in src/database/seed/identities.ts).
DEV_LOGIN_USER=mgolan
# How long a verified identity + its groups are cached before being re-resolved.
AUTH_CACHE_TTL_SECONDS=60

# External group keys (permissions.group_name) whose members may manage permission groups / see the dashboard.
PERMISSION_ADMIN_GROUPS=staff
DASHBOARD_GROUPS=staff

# When true, a summary also requires the groups of every collection that contains it (handoff §4; unconfirmed).
ACCESS_INHERIT_COLLECTION_PERMISSIONS=false

# Wall-clock zone for eventDate/eventSecTime and date-range filters.
APP_TIMEZONE=Asia/Jerusalem

UPLOAD_DIR=.data/uploads
MAX_FILE_MB=50
MAX_FILES_PER_SUMMARY=20
EXPORT_MAX=5000
IMPORT_MAX_ROWS=2000

# E-mail (see .env.example)
APP_URL=http://localhost:81
MAIL_TRANSPORT=smtp
MAIL_REDIRECT_TO=michal@golan.biz
MAIL_PREVIEW_DIR=.data/mail-preview
SMTP_URL=smtp://bygak5dumd4p66n4%40ethereal.email:r98BnbngdXgqv34JFX@smtp.ethereal.email:587
MAIL_FROM=Summer <michal@golan.biz>
# Microsoft Graph mail: fill these in, then set MAIL_TRANSPORT=graph and run `npm run mail:test`
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
