# Summer API base URL (summer-server's global prefix is /api)
SUMMER_API_URL=http://localhost:8080/api

# HTTP mode: the port the MCP listens on (POST /mcp). The MCP has no sign-in of its own for now.
PORT=8090

# Who the MCP acts as. Leave SUMMER_TOKEN empty against a dev server: the MCP then fetches a dev token
# for SUMMER_DEV_USER (a username; empty = the server's default dev user).
SUMMER_TOKEN=
SUMMER_DEV_USER=
